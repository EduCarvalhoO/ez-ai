# Copie para .env (que o .gitignore ignora) e troque CADA valor por um segredo próprio.
# Gerar um valor: openssl rand -hex 32   (ou: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
POSTGRES_PASSWORD=troque-me
CLICKHOUSE_PASSWORD=troque-me
REDIS_AUTH=troque-me
MINIO_ROOT_PASSWORD=troque-me
NEXTAUTH_SECRET=troque-me
LANGFUSE_SALT=troque-me
# Exatamente 64 caracteres hexadecimais (openssl rand -hex 32). Trocar depois apaga o acesso às chaves guardadas.
LANGFUSE_ENCRYPTION_KEY=troque-me
# Fixe a versão depois do primeiro teste (ex.: 3.50.0) para atualizar só de propósito.
LANGFUSE_VERSION=3
# Depois de criar seu usuário na tela, mude para true e rode "docker compose up -d" de novo.
AUTH_DISABLE_SIGNUP=false
