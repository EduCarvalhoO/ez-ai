{
  "$schema": "https://raw.githubusercontent.com/EduCarvalhoO/ez-ai/main/schemas/policy.v0.schema.json",
  "policyVersion": 0,
  "rules": [
    {
      "id": "sem-rede-externa",
      "effect": "deny",
      "category": "network",
      "patterns": [
        "*"
      ],
      "except": [
        "api.github.com",
        "*.npmjs.org"
      ],
      "critical": true,
      "reason": "Agentes não falam com a internet, salvo GitHub e npm"
    },
    {
      "id": "scripts-npm",
      "effect": "deny",
      "category": "write",
      "mark": "executable",
      "packages": [
        "terceiro/*"
      ],
      "reason": "Pacote de fora da empresa não mexe em package.json"
    },
    {
      "id": "hooks-com-cuidado",
      "effect": "require-approval",
      "category": "type",
      "patterns": [
        "hook",
        "mcp"
      ],
      "reason": "Hook e MCP rodam código"
    },
    {
      "id": "sem-pip",
      "effect": "deny",
      "category": "execute",
      "patterns": [
        "pip",
        "curl.exe"
      ],
      "reason": "Dependência Python só pelo time de plataforma"
    },
    {
      "id": "segredos-de-nuvem",
      "effect": "deny",
      "category": "secrets",
      "patterns": [
        "AWS_SECRET_ACCESS_KEY",
        "gcp_key"
      ],
      "reason": "Credenciais de nuvem ficam fora dos agentes"
    },
    {
      "id": "pasta-financeira",
      "effect": "deny",
      "category": "read",
      "patterns": [
        "financeiro/**"
      ],
      "reason": "Dados financeiros"
    },
    {
      "id": "hooks-do-copilot",
      "effect": "warn",
      "category": "configureEnvironment",
      "patterns": [
        ".github/hooks/*.json"
      ],
      "reason": "Hooks do Copilot ainda em prévia"
    },
    {
      "id": "leitura-ampla",
      "effect": "warn",
      "category": "read",
      "mark": "broad",
      "reason": "Lê tudo"
    }
  ]
}
