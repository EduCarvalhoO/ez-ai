{
  "$schema": "https://raw.githubusercontent.com/EduCarvalhoO/ez-ai/main/schemas/package-manifest.v0.schema.json",
  "manifestVersion": 0,
  "name": "eduardo/revisao-ts",
  "version": "1.2.0-beta.1",
  "description": "Agente revisor, hook de lint e MCP do GitHub para projetos TypeScript",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/eduardo/revisao-ts",
  "signature": {
    "identity": "https://github.com/eduardo/revisao-ts/.github/workflows/release.yml@refs/tags/v1.2.0-beta.1",
    "issuer": "https://token.actions.githubusercontent.com"
  },
  "compatibility": {
    "harness": ">=0.1.0 <1.0.0",
    "environments": [
      "claude-code",
      "copilot"
    ]
  },
  "components": [
    {
      "id": "revisor",
      "type": "agent",
      "file": "agentes/revisor.md",
      "description": "Revisa diffs de TypeScript",
      "permissions": {
        "read": [
          "src/**",
          "test/**/*.ts"
        ],
        "execute": [
          {
            "program": "npm",
            "arguments": [
              "test"
            ]
          }
        ],
        "write": [
          "src/**"
        ]
      }
    },
    {
      "id": "lint",
      "type": "hook",
      "file": "hooks/lint.mjs",
      "event": "before-tool",
      "command": {
        "program": "node",
        "arguments": [
          "hooks/lint.mjs"
        ]
      },
      "permissions": {
        "read": [
          "src/**"
        ],
        "configureEnvironment": [
          ".claude/settings.json",
          ".github/hooks/*.json"
        ]
      }
    },
    {
      "id": "github",
      "type": "mcp",
      "file": "mcp/github.json",
      "command": {
        "program": "npx",
        "arguments": [
          "-y",
          "@modelcontextprotocol/server-github@2025.4.8"
        ]
      },
      "permissions": {
        "network": [
          "api.github.com"
        ],
        "secrets": [
          "GITHUB_TOKEN"
        ],
        "configureEnvironment": [
          ".mcp.json",
          ".vscode/mcp.json"
        ]
      }
    }
  ]
}
