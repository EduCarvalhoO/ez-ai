{
  "$schema": "https://raw.githubusercontent.com/EduCarvalhoO/ez-ai/main/schemas/package-manifest.v0.schema.json",
  "manifestVersion": 0,
  "name": "eduardo/revisao-ts",
  "version": "1.2.0-beta.1",
  "description": "Agente revisor, hook de lint e MCP do GitHub para projetos TypeScript",
  "license": "MIT OR Apache-2.0",
  "repository": "https://github.com/eduardo/revisao-ts",
  "signature": {
    "identity": "https://github.com/eduardo/revisao-ts/.github/workflows/release.yml@refs/tags/v1.2.0-beta.1",
    "issuer": "https://token.actions.githubusercontent.com"
  },
  "compatibility": {
    "harness": ">=0.1.0 <1.0.0",
    "environments": [
      "claude-code",
      "copilot"
    ]
  },
  "components": [
    {
      "id": "revisor",
      "type": "agent",
      "file": "agentes/revisor.md",
      "description": "Revisa diffs de TypeScript",
      "permissions": {
        "read": [
          "src/**",
          "test/**/*.ts"
        ],
        "execute": [
          {
            "program": "npm",
            "arguments": [
              "test"
            ]
          }
        ]
      }
    },
    {
      "id": "lint",
      "type": "hook",
      "file": "hooks/lint.mjs",
      "event": "before-tool",
      "command": {
        "program": "node",
        "arguments": [
          "hooks/lint.mjs"
        ]
      },
      "permissions": {
        "read": [
          "src/**"
        ],
        "configureEnvironment": [
          ".claude/settings.json",
          ".github/hooks/*.json"
        ]
      }
    },
    {
      "id": "github",
      "type": "mcp",
      "file": "mcp/github.json",
      "command": {
        "program": "npx",
        "arguments": [
          "-y",
          "@modelcontextprotocol/server-github@2025.4.8"
        ]
      },
      "permissions": {
        "network": [
          "h0.exemplo.com",
          "h1.exemplo.com",
          "h2.exemplo.com",
          "h3.exemplo.com",
          "h4.exemplo.com",
          "h5.exemplo.com",
          "h6.exemplo.com",
          "h7.exemplo.com",
          "h8.exemplo.com",
          "h9.exemplo.com",
          "h10.exemplo.com",
          "h11.exemplo.com",
          "h12.exemplo.com",
          "h13.exemplo.com",
          "h14.exemplo.com",
          "h15.exemplo.com",
          "h16.exemplo.com",
          "h17.exemplo.com",
          "h18.exemplo.com",
          "h19.exemplo.com",
          "h20.exemplo.com",
          "h21.exemplo.com",
          "h22.exemplo.com",
          "h23.exemplo.com",
          "h24.exemplo.com",
          "h25.exemplo.com",
          "h26.exemplo.com",
          "h27.exemplo.com",
          "h28.exemplo.com",
          "h29.exemplo.com",
          "h30.exemplo.com",
          "h31.exemplo.com",
          "h32.exemplo.com",
          "h33.exemplo.com",
          "h34.exemplo.com",
          "h35.exemplo.com",
          "h36.exemplo.com",
          "h37.exemplo.com",
          "h38.exemplo.com",
          "h39.exemplo.com",
          "h40.exemplo.com",
          "h41.exemplo.com",
          "h42.exemplo.com",
          "h43.exemplo.com",
          "h44.exemplo.com",
          "h45.exemplo.com",
          "h46.exemplo.com",
          "h47.exemplo.com",
          "h48.exemplo.com",
          "h49.exemplo.com",
          "h50.exemplo.com"
        ],
        "secrets": [
          "GITHUB_TOKEN"
        ],
        "configureEnvironment": [
          ".mcp.json",
          ".vscode/mcp.json"
        ]
      }
    }
  ]
}
