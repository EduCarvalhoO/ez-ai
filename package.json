{
  "name": "harness-ai",
  "version": "0.0.0",
  "private": true,
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "harness-ai": "dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "commits:check": "node scripts/validar-commits.mjs",
    "schemas": "npm run build && node scripts/gerar-schemas.mjs && biome format --write schemas"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1"
  }
}
