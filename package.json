{
  "name": "ez-ai",
  "version": "0.0.0",
  "description": "Plataforma modular de engenharia e governança de agentes de IA, instalável por CLI.",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduCarvalhoO/ez-ai.git"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE.md",
    "README.md"
  ],
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "bin": {
    "ez-ai": "dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "sbom": "node scripts/gerar-sbom.mjs",
    "commits:check": "node scripts/validar-commits.mjs",
    "schemas": "npm run build && node scripts/gerar-schemas.mjs && biome format --write schemas"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.4",
    "@sigstore/bundle": "5.0.0",
    "@sigstore/protobuf-specs": "0.5.2",
    "@sigstore/verify": "4.1.2"
  }
}
