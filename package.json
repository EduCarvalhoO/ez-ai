{
  "name": "harness-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "bin": {
    "harness-ai": "dist/cli/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "format:check": "biome format",
    "commits:check": "node scripts/validar-commits.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "cac": "7.1.0",
    "minimist": "1.2.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
