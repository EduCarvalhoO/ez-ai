{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EduCarvalhoO/ez-ai/main/schemas/policy.v0.schema.json",
  "title": "Policy do ez-ai (v0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["policyVersion", "rules"],
  "properties": {
    "$schema": {
      "type": "string",
      "maxLength": 512,
      "pattern": "^https://"
    },
    "policyVersion": {
      "const": 0
    },
    "rules": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "effect", "category", "reason"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "effect": {
          "enum": ["warn", "require-approval", "deny"]
        },
        "category": {
          "enum": ["read", "write", "execute", "network", "secrets", "configureEnvironment", "type", "content"]
        },
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9._/*?-]+$"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "mark": {
          "enum": ["broad", "sensitive", "executable"]
        },
        "except": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9._/*?-]+$"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 104,
            "pattern": "^[a-z0-9](?:-?[a-z0-9]){0,38}/(?:\\*|[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?)$"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "critical": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "required": ["patterns"],
              "not": {
                "required": ["mark"]
              }
            },
            {
              "required": ["mark"],
              "not": {
                "anyOf": [
                  {
                    "required": ["patterns"]
                  },
                  {
                    "required": ["except"]
                  }
                ]
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "effect": {
                  "const": "deny"
                }
              }
            },
            {
              "not": {
                "required": ["critical"]
              }
            }
          ]
        }
      ]
    }
  }
}
