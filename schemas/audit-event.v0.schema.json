{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EduCarvalhoO/ez-ai/main/schemas/audit-event.v0.schema.json",
  "title": "Evento de auditoria do ez-ai (v0), uma linha do JSONL",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventVersion", "seq", "at", "type", "actor", "harness", "result", "data", "previous", "hash"],
  "properties": {
    "eventVersion": {
      "const": 0
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "type": {
      "enum": ["operation", "policy-decision", "approval", "owner-change", "verification", "step"]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["human", "agent", "ci"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "harness": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "result": {
      "enum": ["requested", "executed", "verified", "failed", "skipped"]
    },
    "reasonCode": {
      "enum": [
        "skipped-by-user",
        "no-package-json",
        "tool-missing",
        "git-unavailable",
        "network-unavailable",
        "validation-rejected",
        "policy-denied",
        "approval-pending",
        "local-conflict",
        "timeout",
        "command-failed",
        "internal-error"
      ]
    },
    "detail": {
      "type": "string",
      "maxLength": 200
    },
    "data": {
      "type": "object"
    },
    "previous": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "operation"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "policy-decision"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/policy-decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "approval"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/approval"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "owner-change"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/owner-change"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "verification"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/verification"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "step"
          }
        },
        "required": ["type"]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/step"
          }
        }
      }
    }
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "dryRun", "packages"],
      "properties": {
        "command": {
          "enum": ["init", "add", "remove", "update", "list", "plan", "apply", "validate", "doctor", "audit"]
        },
        "dryRun": {
          "type": "boolean"
        },
        "sealed": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "hash"],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}\\.jsonl$"
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "packages": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key"],
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 104,
                "pattern": "^[a-z0-9](?:-?[a-z0-9]){0,38}/[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
              },
              "version": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
              },
              "commit": {
                "type": "string",
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          }
        }
      }
    },
    "policy-decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "effect", "items"],
      "properties": {
        "package": {
          "type": "string",
          "maxLength": 104,
          "pattern": "^[a-z0-9](?:-?[a-z0-9]){0,38}/[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "effect": {
          "enum": ["warn", "require-approval", "deny", "free"]
        },
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level", "rule"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^(?:comp|policy|dono)/[!-~]+$"
              },
              "level": {
                "enum": ["core", "organization", "project", "package"]
              },
              "rule": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              }
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "entries"],
      "properties": {
        "package": {
          "type": "string",
          "maxLength": 104,
          "pattern": "^[a-z0-9](?:-?[a-z0-9]){0,38}/[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "commit": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "fingerprint"],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^(?:comp|policy|dono)/[!-~]+$"
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "owner-change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "oldSource", "newSource"],
      "properties": {
        "package": {
          "type": "string",
          "maxLength": 104,
          "pattern": "^[a-z0-9](?:-?[a-z0-9]){0,38}/[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
        },
        "oldSource": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160,
              "pattern": "^https://github\\.com/[a-z0-9](?:-?[a-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}$"
            },
            {
              "type": "string",
              "maxLength": 166,
              "pattern": "^local:[A-Za-z0-9._/-]+$"
            }
          ]
        },
        "newSource": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 160,
              "pattern": "^https://github\\.com/[a-z0-9](?:-?[a-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}$"
            },
            {
              "type": "string",
              "maxLength": 166,
              "pattern": "^local:[A-Za-z0-9._/-]+$"
            }
          ]
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "level"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$"
        },
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["program", "arguments"],
          "properties": {
            "program": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
            },
            "arguments": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "exitCode": {
          "type": "integer",
          "minimum": -255,
          "maximum": 255
        },
        "outputHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "level": {
          "enum": ["environment", "external-validator", "requested-only"]
        },
        "ciRun": {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "step", "agent", "cycle", "round", "start", "end"],
      "properties": {
        "item": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$"
        },
        "step": {
          "enum": ["E0", "E1", "E2", "E3", "E4", "E5", "G0", "G1", "G2", "G3"]
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$"
        },
        "cycle": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "end": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {
            "source": {
              "enum": ["measured-by-environment", "estimated", "unavailable"]
            },
            "model": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$"
            },
            "agent": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]{0,63}$"
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cacheReadTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "cacheWriteTokens": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "costMicroUsd": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "costSource": {
              "enum": ["reported-by-environment", "estimated"]
            }
          }
        }
      }
    }
  }
}
