{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/EduCarvalhoO/ez-ai/main/schemas/lockfile.v0.schema.json",
  "title": "Lockfile do ez-ai (v0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["lockfileVersion", "packages"],
  "properties": {
    "lockfileVersion": {
      "const": 0
    },
    "packages": {
      "type": "object",
      "maxProperties": 100,
      "propertyNames": {
        "type": "string",
        "maxLength": 104,
        "pattern": "^[a-z0-9](?:-?[a-z0-9]){0,38}/[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "source", "hash", "components"],
        "properties": {
          "version": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "source": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 160,
                "pattern": "^https://github\\.com/[a-z0-9](?:-?[a-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}$"
              },
              {
                "type": "string",
                "maxLength": 166,
                "pattern": "^local:[A-Za-z0-9._/-]+$"
              }
            ]
          },
          "tag": {
            "type": "string",
            "maxLength": 65,
            "pattern": "^v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "commit": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "signature": {
            "$ref": "#/$defs/signature"
          },
          "ownApprovals": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "fingerprint"],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 512,
                  "pattern": "^(?:comp|policy|dono)/[!-~]+$"
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          },
          "components": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/$defs/componente"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program"],
      "properties": {
        "program": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "maxItems": 50
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9._/*?-]+$"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "write": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[A-Za-z0-9._/*?-]+$"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "execute": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/command"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "network": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]{0,63}$"
          },
          "maxItems": 50,
          "uniqueItems": true
        },
        "configureEnvironment": {
          "type": "array",
          "items": {
            "enum": [
              ".claude/settings.json",
              ".mcp.json",
              ".vscode/mcp.json",
              ".vscode/settings.json",
              ".github/hooks/*.json"
            ]
          },
          "maxItems": 50,
          "uniqueItems": true
        }
      }
    },
    "componente": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "file"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "type": {
          "enum": ["instruction", "agent", "skill", "hook", "mcp", "policy"]
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "event": {
          "enum": ["before-tool", "after-tool", "prompt-submit", "session-start", "session-end"]
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        }
      },
      "allOf": [
        {
          "anyOf": [
            {
              "properties": {
                "type": {
                  "const": "hook"
                }
              },
              "required": ["event", "command"]
            },
            {
              "properties": {
                "type": {
                  "not": {
                    "const": "hook"
                  }
                }
              },
              "not": {
                "required": ["event"]
              }
            }
          ]
        },
        {
          "anyOf": [
            {
              "properties": {
                "type": {
                  "enum": ["hook", "mcp"]
                },
                "permissions": {
                  "required": ["configureEnvironment"],
                  "properties": {
                    "configureEnvironment": {
                      "minItems": 1
                    }
                  }
                }
              },
              "required": ["command", "permissions"]
            },
            {
              "properties": {
                "type": {
                  "enum": ["instruction", "agent", "skill", "policy"]
                }
              },
              "not": {
                "required": ["command"]
              }
            }
          ]
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "issuer"],
      "properties": {
        "identity": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://github\\.com/[a-z0-9](?:-?[a-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}/\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml@refs/(?:tags|heads)/[A-Za-z0-9._/-]+$"
        },
        "issuer": {
          "const": "https://token.actions.githubusercontent.com"
        }
      }
    }
  }
}
