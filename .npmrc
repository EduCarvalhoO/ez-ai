# Baseline de segurança (docs/guias/padrao-de-codigo-e-testes.md §1).
# Nenhum pacote roda script de instalação (preinstall/install/postinstall).
ignore-scripts=true
# Só instala versões publicadas há 7 dias ou mais (npm 11.10+; o npm 10 ignora e o CI confere
# com scripts/verificar-idade-deps.mjs).
min-release-age=7
